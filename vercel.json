{
  "version": 2,
  "rewrites": [
    {
      "source": "/projects/:slug",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ritual",
      "destination": "https://tyrenbloom-portfolio.onrender.com/ritual",
      "permanent": false
    },
    {
      "source": "/ritual/:path*",
      "destination": "https://tyrenbloom-portfolio.onrender.com/ritual/:path*",
      "permanent": false
    }
  ]
}
